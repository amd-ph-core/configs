/*
 * ---------------------------------------------------------
 *  amd-ph-core/tbvarpipe pipeline parameters
 * ---------------------------------------------------------
 *
 * Static asset path resolution. When static_assets is set
 * (via --static_assets, -c override, or an environment
 * overlay profile), all reference file paths resolve
 * automatically.
 *
 * Lazy closure GStrings (${-> expr}) are used so that the
 * final merged value of static_assets is captured at access
 * time, not at config parse time. This allows -c overrides,
 * --static_assets, and -profile to all work correctly.
 */

params {
    // Enable varpipe processing by default
    varpipe                    = true

    // Static asset root — set via environment profile, -c, or --static_assets
    static_assets              = null

    // Clockwork decontamination references
    clockwork_ref_preprocessing  = "${-> params.static_assets}/clockwork/cdc-tb/ref_preprocessing.fa"
    clockwork_meta_preprocessing = "${-> params.static_assets}/clockwork/cdc-tb/remove_contam_metadata_preprocessing.tsv"

    // Varpipe-WGS reference and annotation files
    ref_fasta    = "${-> params.static_assets}/tbvarpipe/1.0.0/ref2.fa"
    reported     = "${-> params.static_assets}/tbvarpipe/1.0.0/reportable.txt"
    included     = "${-> params.static_assets}/tbvarpipe/1.0.0/intervals.bed"
    bedlist_amp  = "${-> params.static_assets}/tbvarpipe/1.0.0/amp_bed.txt"
    bedlist_one  = "${-> params.static_assets}/tbvarpipe/1.0.0/bed_1.txt"
    bedlist_two  = "${-> params.static_assets}/tbvarpipe/1.0.0/bed_2.txt"
    bedstruct    = "${-> params.static_assets}/tbvarpipe/1.0.0/BED.txt"
    mutationloci = "${-> params.static_assets}/tbvarpipe/1.0.0/mutation_loci.txt"
    lineages     = "${-> params.static_assets}/tbvarpipe/1.0.0/lineage_markers.txt"
    snpeff_cache = "${-> params.static_assets}/snpeff/5.0/tb/mtb_NC_000962_3"
    snpeff_db    = 'mtb_NC_000962_3'
}
