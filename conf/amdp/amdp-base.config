/*
 * ---------------------------------------------------------
 *  AMDP base environment overlay for amd-ph-core pipelines
 * ---------------------------------------------------------
 *
 * Common settings shared by all AMDP environments.
 * Each environment config sets params.amdp_env before including this file.
 *
 * Naming conventions derived from params.amdp_env:
 *   queue:         amdp-${amdp_env}-batch-ec2-job-queue
 *   static_assets: s3://amdp-${amdp_env}-static-assets/amd-ph-core-static-assets
 *   workDir:       set per-environment (bucket naming varies)
 */

def amdp_env = params.amdp_env

// ---------------------------------------------------------------------------
// AWS Batch execution
// ---------------------------------------------------------------------------
aws {
    batch {
        cliPath          = '/home/ec2-user/miniconda/bin/aws'
        maxSpotAttempts  = 3
    }
    region = 'us-east-1'
}

process {
    executor       = 'awsbatch'
    queue          = "amdp-${amdp_env}-batch-ec2-job-queue"
    maxRetries     = 3
    errorStrategy  = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }

    resourceLimits = [
        cpus:   192,
        memory: '768.GB',
        time:   '24.h',
    ]
}

// ---------------------------------------------------------------------------
// Container registry (internal ECR)
// ---------------------------------------------------------------------------
def aws_account_id = System.getenv('AWS_ACCOUNT_ID') ?: params.aws_account_id
docker.registry  = "${aws_account_id}.dkr.ecr.us-east-1.amazonaws.com"
podman.registry  = "${aws_account_id}.dkr.ecr.us-east-1.amazonaws.com"
wave.enabled     = false
fusion.enabled   = false

// ---------------------------------------------------------------------------
// Params (S3 assets, container org)
// ---------------------------------------------------------------------------
params {
    container_org = 'oamd-bio-'
    static_assets = "s3://amdp-${amdp_env}-static-assets/amd-ph-core-static-assets"
}
