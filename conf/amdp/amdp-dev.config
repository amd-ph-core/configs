/*
 * ---------------------------------------------------------
 *  AMDP Dev environment overlay for amd-ph-core pipelines
 * ---------------------------------------------------------
 *
 * Internal-only settings that external users cannot replicate:
 *   - AWS Batch executor and job queue
 *   - ECR container registry
 *   - S3 work and static asset paths
 *
 * Usage:
 *   nextflow run amd-ph-core/tbvarpipe -r 1.2.0 \
 *     -profile docker,amdp_dev \
 *     --input s3://amdp-dev-bio-development-data/oamd-bio-tb-varpipe/inputs/samplesheet.csv \
 *     --outdir s3://amdp-dev-bio-development-data/oamd-bio-tb-varpipe/results
 */

// ---------------------------------------------------------------------------
// S3 base paths (resolved before pipeline-specific paths)
// ---------------------------------------------------------------------------
def amdp_bucket      = 'amdp-dev-bio-development-work'
def amdp_environment = 'dev'
def amdp_pipeline    = manifest.containsKey('name') ? manifest.name.split('/').last() : 'pipeline'
def amdp_ts          = new Date().format('yyyy.MM.dd-HH.mm.ss')

// ---------------------------------------------------------------------------
// Work directory in S3 (per-run, timestamped)
// ---------------------------------------------------------------------------
workDir = "s3://${amdp_bucket}/work/${amdp_environment}/${amdp_pipeline}-${amdp_ts}"

// ---------------------------------------------------------------------------
// AWS Batch execution
// ---------------------------------------------------------------------------
aws {
    batch {
        cliPath          = '/home/ec2-user/miniconda/bin/aws'
        maxSpotAttempts  = 3
    }
    region = 'us-east-1'
}

process {
    executor       = 'awsbatch'
    queue          = 'amdp-dev-batch-ec2-job-queue'
    maxRetries     = 3
    errorStrategy  = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }

    resourceLimits = [
        cpus:   192,
        memory: '768.GB',
        time:   '24.h',
    ]
}

// ---------------------------------------------------------------------------
// Container registry (internal ECR)
// ---------------------------------------------------------------------------
def aws_account_id = System.getenv('AWS_ACCOUNT_ID') ?: params.aws_account_id
docker.registry  = "${aws_account_id}.dkr.ecr.us-east-1.amazonaws.com"
podman.registry  = "${aws_account_id}.dkr.ecr.us-east-1.amazonaws.com"
wave.enabled     = false
fusion.enabled   = false

// ---------------------------------------------------------------------------
// Static assets (S3)
// ---------------------------------------------------------------------------
params {
    static_assets = 's3://amdp-dev-static-assets/amd-ph-core-static-assets'
}
