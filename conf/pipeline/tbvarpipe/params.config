/*
 * ---------------------------------------------------------
 *  amd-ph-core/tbvarpipe pipeline parameters
 * ---------------------------------------------------------
 *
 * Static asset path resolution. When static_assets is set
 * (via --static_assets, -c override, or an environment
 * overlay profile), all reference file paths resolve
 * automatically.
 *
 * The params below still use lazy GStrings (${-> expr}) so the final
 * merged value of static_assets is captured at access time rather than
 * at config parse time. That is what lets -c, --static_assets and
 * -profile all work.
 *
 * NEXTFLOW 26.04: ${-> } is a parse error under the new config parser,
 * so runs need NXF_SYNTAX_PARSER=v1 until this is resolved. It cannot
 * be fixed in this file:
 *
 *   - plain eager "${params.static_assets}/..." resolves too early and
 *     silently yields null/... when static_assets arrives via -c, which
 *     is what the quick start guide documents;
 *   - a closure value ({ "..." }) is not evaluated for params -- it
 *     stays a Closure object, breaking file(), tokenize() and nf-schema
 *     string validation.
 *
 * The fix belongs in the pipeline: keep static_assets here and derive
 * these paths in workflow code after config merge, preserving
 * per-path override, e.g.
 *     def ref_fasta = params.ref_fasta ?: "${sa}/tbvarpipe/1.0.0/ref2.fa"
 *
 * Container directives in containers.config had no such constraint and
 * now use ordinary { } closures, which resolve at task time.
 */

params {
    // Enable varpipe processing by default
    varpipe                    = true

    // Static asset root — set via environment profile, -c, or --static_assets
    static_assets              = params.static_assets ?: null

    // Container image org prefix — override in environment profiles
    container_org              = params.container_org ?: 'cdc-amd/'

    // Clockwork decontamination references
    clockwork_ref_preprocessing  = "${-> params.static_assets}/clockwork/cdc-tb/ref_preprocessing.fa"
    clockwork_meta_preprocessing = "${-> params.static_assets}/clockwork/cdc-tb/remove_contam_metadata_preprocessing.tsv"

    // Varpipe-WGS reference and annotation files
    ref_fasta    = "${-> params.static_assets}/tbvarpipe/1.0.0/ref2.fa"
    reported     = "${-> params.static_assets}/tbvarpipe/1.0.0/reportable.txt"
    included     = "${-> params.static_assets}/tbvarpipe/1.0.0/intervals.bed"
    bedlist_amp  = "${-> params.static_assets}/tbvarpipe/1.0.0/amp_bed.txt"
    bedlist_one  = "${-> params.static_assets}/tbvarpipe/1.0.0/bed_1.txt"
    bedlist_two  = "${-> params.static_assets}/tbvarpipe/1.0.0/bed_2.txt"
    bedstruct    = "${-> params.static_assets}/tbvarpipe/1.0.0/BED.txt"
    mutationloci = "${-> params.static_assets}/tbvarpipe/1.0.0/mutation_loci.txt"
    lineages     = "${-> params.static_assets}/tbvarpipe/1.0.0/lineage_markers.txt"
    snpeff_cache = "${-> params.static_assets}/snpeff/5.0/tb/data"
    snpeff_db    = 'mtb_NC_000962_3'
}
